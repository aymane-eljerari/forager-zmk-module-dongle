// clang-format off
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <behaviors/rgbled_widget.dtsi>  // needed to use the behaviors

#define MEH   LS(LC(LALT))
// Hyper = Ctrl+Alt+Cmd+Shift, matching skhd's `hyper` keyword and the
// Voyager's LM()-based Hyper. Same nested-modifier-on-a-modifier-keycode
// trick as MEH above, one level deeper.
#define HYPER LS(LC(LA(LGUI)))

#define BASE   0
#define SYM    1
#define NUM    2
#define DSK    3
#define NAV    4
#define APP    5
#define ONE    6
#define WARP   7
#define STACK  8
#define RESIZE 9


/ {
    behaviors {

        // yabai scratchpad apps
        am: app_macro {
            compatible = "zmk,behavior-macro-one-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <1>;
            bindings
                = <&macro_press &kp LSHIFT &kp LCTRL &kp LALT &kp LCMD>
                , <&macro_param_1to1>
                , <&macro_tap &kp MACRO_PLACEHOLDER>
                , <&macro_release &kp LSHIFT &kp LCTRL &kp LALT &kp LCMD>
                ;
        };

        // NAV layer utils
        mm: misc_macro {
            compatible = "zmk,behavior-macro-one-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <1>;
            bindings
                = <&macro_press &kp LCMD &kp LSHIFT>
                , <&macro_param_1to1>
                , <&macro_tap &kp MACRO_PLACEHOLDER>
                , <&macro_release &kp LCMD &kp LSHIFT>
                ;
        };

        cpb: clipboard_macro {
            compatible = "zmk,behavior-macro-one-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <1>;
            bindings
                = <&macro_press &kp LCMD &kp LALT>
                , <&macro_param_1to1>
                , <&macro_tap &kp MACRO_PLACEHOLDER>
                , <&macro_release &kp LCMD &kp LALT>
                ;
        };


        lck: lock_screen_macro {
            compatible = "zmk,behavior-macro-one-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <1>;
            bindings
                = <&macro_press &kp LCMD &kp LCTRL>
                , <&macro_param_1to1>
                , <&macro_tap &kp MACRO_PLACEHOLDER>
                , <&macro_release &kp LCMD &kp LCTRL>
                ;
        };

        cam: camera_macro {
            compatible = "zmk,behavior-macro-one-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <1>;
            bindings
                = <&macro_press &kp LALT &kp LCTRL &kp LCMD>
                , <&macro_param_1to1>
                , <&kp MACRO_PLACEHOLDER>
                , <&macro_pause_for_release>
                , <&macro_release &kp LALT &kp LCTRL &kp LCMD>
                ;
        };


    };

    combos {
        compatible = "zmk,combos";
        combo_lcmd {
            timeout-ms = <35>;
            key-positions = <12 13>;
            bindings = <&kp LCMD>;
            layers = <0>;
        };

        combo_rcmd {
            timeout-ms = <35>;
            key-positions = <16 17>;
            bindings = <&kp LCMD>;
            layers = <0>;
        };

        combo_lalt {
            timeout-ms = <35>;
            key-positions = <11 12>;
            bindings = <&kp LALT>;
            layers = <0>;
        };

        combo_ralt {
            timeout-ms = <35>;
            key-positions = <17 18>;
            bindings = <&kp LALT>;
            layers = <0>;
        };

        combo_lctrl {
            timeout-ms = <35>;
            key-positions = <11 13>;
            bindings = <&kp LCTRL>;
            layers = <0>;
        };

        combo_rctrl {
            timeout-ms = <35>;
            key-positions = <16 18>;
            bindings = <&kp LCTRL>;
            layers = <0>;
        };

        combo_l_zellij_main {
            timeout-ms = <35>;
            key-positions = <11 12 13>;
            bindings = <&kp LS(LC(LCMD))>;
            layers = <0>;
        };

        combo_r_zellij_main {
            timeout-ms = <35>;
            key-positions = <16 17 18>;
            bindings = <&kp LS(LC(LCMD))>;
            layers = <0>;
        };

        combo_l_reset {
            timeout-ms = <35>;
            key-positions = <0 4>;
            bindings = <&sys_reset>;
            layers = <0>;
        };

        combo_r_reset {
            timeout-ms = <35>;
            key-positions = <5 9>;
            bindings = <&sys_reset>;
            layers = <0>;
        };

        combo_soft_off_l {
            timeout-ms = <25>;
            key-positions = <2 11 13>;
            bindings = <&soft_off>;
            layers = <0>;
        };
        
        combo_soft_off_r {
            timeout-ms = <25>;
            key-positions = <7 16 18>;
            bindings = <&soft_off>;
            layers = <0>;
        };
    };



    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
            &kp B           &kp L           &kp D           &kp C           &kp V                                          &kp J           &kp F           &kp O           &kp U           &kp SPACE
            &kp N           &kp R           &kp T           &kp S           &kp G                                          &kp Y           &kp H           &kp A           &kp E           &kp I
            &kp X           &kp Q           &kp M           &kp W           &kp Z                                          &kp K           &kp P           &kp SLASH       &kp DOT      &kp COMMA
                                                            &mo DSK         &mo SYM                                        &kp SPACE       &kp LSHIFT
            >;
        };

        sym {
            display-name = "Symbol";
            bindings = <
            &mo NUM         &kp PERCENT     &kp LPAR        &kp RPAR        &kp AT                                         &kp PLUS        &kp LBKT        &kp RBKT        &kp ESC         &kp DELETE
            &kp TAB         &kp CARET       &kp STAR        &kp EQUAL    &kp DOLLAR                                        &kp MINUS       &kp SEMICOLON   &kp APOSTROPHE  &kp BACKSLASH   &kp ENTER
            &kp HYPER       &kp UNDER       &kp LT          &kp GT          &kp HASH                                       &kp BACKSPACE   &kp EXCL        &kp AMPERSAND   &kp GRAVE       &to ONE
                                                            &none           &none                                          &kp SPACE       &kp LSHIFT
            >;
        };

        num {
            display-name = "Number";
            bindings = <
            &none           &kp PERCENT     &kp LPAR        &kp RPAR        &kp KP_DIVIDE                                  &kp PLUS        &kp N7       &kp N8       &kp N9       &none
            &none           &kp CARET       &kp STAR        &kp EQUAL       &kp DOT                                        &kp MINUS       &kp N4       &kp N5       &kp N6       &kp ENTER
            &none           &kp UNDER       &kp LT          &kp GT          &kp COMMA                                      &kp BACKSPACE   &kp N1       &kp N2       &kp N3       &none
                                                            &to BASE        &none                                          &kp SPACE       &kp N0
            >;
        };

        dsk {
            display-name = "Desk";
            // DSK is now a bare &mo (no modifier baked into the hold), so
            // NAV — entered as a nested &mo on this same layer's thumb key —
            // never inherits a stuck modifier (a continuous Hyper hold here
            // would otherwise contaminate NAV's arrows/media keys/macros the
            // whole time NAV is active, the same class of bug already fixed
            // on the Voyager, but ZMK has no layer_state_set_user equivalent
            // to strip it mid-hold). Every action key below instead uses the
            // &am tap-macro (press Hyper, tap, release Hyper — already
            // proven on the APP layer) to add Hyper just for its own tap.
            // LSHIFT/LALT/LCMD used to live in the WARP/STACK/RESIZE slots
            // for composing extra modifiers on top of DSK's old Ctrl-only
            // hold; repurposed as the WARP/STACK/RESIZE momentary sublayers
            // (mirroring the Voyager's MO(9)/MO(11)/MO(10) row, same
            // move/stack/resize order), held with this hand and tapped with
            // H/J/K/L below.
            bindings = <
            &am B           &mo WARP        &mo STACK       &mo RESIZE      &none                                          &am Y           &am U           &am I           &am O           &am P
            &am N1          &am N2          &am N3          &am N4          &am N5                                         &am H           &am J           &am K           &am L           &none
            &none           &am T           &none           &none           &none                                          &none           &am MINUS       &am EQUAL       &am APOS        &am GRAVE
                                                            &am APOSTROPHE  &am GRAVE                                      &mo NAV         &mo APP
            >;
        };

        nav {
            display-name = "Nav";
            bindings = <
            &kp C_BRI_UP    &kp LSHIFT      &kp LCTRL       &kp MEH         &kp C_VOL_UP                                   &none           &cam PLUS    &cam O          &cam U          &none
            &kp C_BRI_DN    &kp C_PREV      &kp C_PP        &kp C_NEXT      &kp C_VOL_DN                                   &kp LEFT        &kp DOWN     &kp UP          &kp RIGHT       &kp ENTER
            &cpb C          &mm N5          &lck Q          &mm D           &kp C_MUTE                                     &kp BACKSPACE   &cam MINUS   &cam F          &cam P          &cam R
                                                            &kp LALT        &kp LCMD                                       &none           &studio_unlock
            >;
        };

        app {
            display-name = "App";
            bindings = <
            &am B           &am L           &am D           &am C           &am V                                          &am J           &am F           &am O           &am U           &none
            &am N           &am R           &am T           &am S           &am G                                          &am Y           &am H           &am A           &am E           &am I
            &am X           &am Q           &am M           &am W           &am Z                                          &am K           &am P           &none           &none           &none
                                                            &none           &none                                          &none           &none
            >;
        };


        one {
            display-name = "One";
            bindings = <
            &kp ESC         &kp LSHIFT      &kp LCTRL       &kp LCMD        &kp DEL                                        &none           &none           &none           &none           &ind_con
            &kp TAB         &kp LG(C)       &kp LG(X)       &kp LG(V)       &kp LG(E)                                      &none           &none           &none           &none           &ind_bat
            &none           &kp LG(Z)       &kp LG(LS(Z))   &none           &none                                          &none           &none           &none           &none           &to BASE
                                                            &kp LALT        &none                                          &none           &none
            >;
        };

        // WARP/STACK/RESIZE: momentary overlays on DSK, held from the
        // left-hand row above (WARP/STACK/RESIZE keys) and tapped here with
        // the right hand at the same H/J/K/L position DSK uses for focus,
        // in the same west/south/north/east order. DSK no longer holds
        // Hyper continuously (see the dsk layer comment), so each direction
        // key uses &am to add it just for its own tap — everything else
        // stays &trans.
        warp {
            display-name = "Warp";
            // swapped with resize below per request: warp now sends 7/8/9/0
            bindings = <
            &trans          &trans          &trans          &trans          &trans                                         &trans          &trans          &trans          &trans          &trans
            &trans          &trans          &trans          &trans          &trans                                         &am N7          &am N8          &am N9          &am N0          &trans
            &trans          &trans          &trans          &trans          &trans                                         &trans          &trans          &trans          &trans          &trans
                                                            &trans          &trans                                         &trans          &trans
            >;
        };

        stack {
            display-name = "Stack";
            bindings = <
            &trans          &trans          &trans          &trans          &trans                                         &trans          &trans          &trans          &trans          &trans
            &trans          &trans          &trans          &trans          &trans                                         &am Q           &am W           &am E           &am R           &trans
            &trans          &trans          &trans          &trans          &trans                                         &trans          &trans          &trans          &trans          &trans
                                                            &trans          &trans                                         &trans          &trans
            >;
        };

        resize {
            display-name = "Resize";
            // swapped with warp above per request: resize now sends z/x/c/v
            bindings = <
            &trans          &trans          &trans          &trans          &trans                                         &trans          &trans          &trans          &trans          &trans
            &trans          &trans          &trans          &trans          &trans                                         &am Z           &am X           &am C           &am V           &trans
            &trans          &trans          &trans          &trans          &trans                                         &trans          &trans          &trans          &trans          &trans
                                                            &trans          &trans                                         &trans          &trans
            >;
        };
    };

// soft_off {
//    hold-time-ms = <3000>; // Only turn off it the key is held for 5 seconds or longer.
// };

};

